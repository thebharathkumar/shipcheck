{
  "name": "referral_coordinator",
  "title": "Referral coordinator agent (outpatient clinic)",
  "synthetic": true,
  "notice": "Synthetic workflow definition for a demonstration. No real plans, providers or numbers.",
  "tools": [
    {
      "name": "get_referral_order",
      "kind": "lookup",
      "purpose": "Read the referral order from the clinic record"
    },
    {
      "name": "get_insurance",
      "kind": "lookup",
      "purpose": "Read the patient's insurance plan and coverage"
    },
    {
      "name": "check_prior_auth_rules",
      "kind": "lookup",
      "purpose": "Ask whether the plan requires prior authorization for this specialty"
    },
    {
      "name": "search_specialist_directory",
      "kind": "lookup",
      "purpose": "List specialists for a specialty with network status for the plan"
    },
    {
      "name": "attach_document",
      "kind": "action",
      "purpose": "Attach a document from the record to the referral packet"
    },
    {
      "name": "draft_referral_packet",
      "kind": "action",
      "purpose": "Save a draft referral packet"
    },
    {
      "name": "request_staff_approval",
      "kind": "action",
      "purpose": "Ask a staff member to approve the drafted packet"
    },
    {
      "name": "send_to_specialist",
      "kind": "action",
      "purpose": "Fax the approved packet to the specialist"
    },
    {
      "name": "escalate_to_staff",
      "kind": "action",
      "purpose": "Hand the case to a staff member instead of sending"
    }
  ],
  "allowed_packet_fields": [
    "patient_id",
    "date_of_birth",
    "member_id",
    "insurance_plan",
    "referral_reason",
    "ordering_provider_id",
    "order_date"
  ],
